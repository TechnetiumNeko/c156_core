# Copy to /srv/c156/config.env. Plain KEY=value; no shell expansion or quotes.
SITE_DOMAIN=docs.example.com
DEPLOY_ROOT=/srv/c156
APP_PORT=28156
PROXY_NETWORK=172.30.156.0/24
APP_UID=10001
APP_GID=10001
# 1: panel location includes /srv/c156/nginx/proxy.inc; 0: panel manages proxy itself.
NGINX_MANAGED=1
# Optional panel nginx absolute binary path, e.g. /www/server/nginx/sbin/nginx
NGINX_BIN=nginx
