# setup.sh creates this under the deployment user home/c156 by default. Plain KEY=value; no shell expansion or quotes.
SITE_DOMAIN=docs.example.com
# Empty uses the directory containing this file; setup writes the actual absolute root.
DEPLOY_ROOT=
APP_PORT=28156
PROXY_NETWORK=172.30.156.0/24
# Empty uses the deployment account UID/GID; setup records them. Root falls back to 10001.
APP_UID=
APP_GID=
# 0: administrator/panel owns Nginx and TLS (recommended).
# 1: account can validate/reload Nginx; site includes DEPLOY_ROOT/nginx/proxy.inc.
NGINX_MANAGED=0
# Optional panel nginx absolute binary path, e.g. /www/server/nginx/sbin/nginx
NGINX_BIN=nginx
