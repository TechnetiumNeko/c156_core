# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# SQLite transient journal files (keep the .folder databases in data/)
*-journal
*-wal
*-shm

# Unified runtime content database (legacy .folder containers stay tracked)
/data/c156.sqlite
/.c156/
# Launcher generated for this checkout's absolute path
/C156.desktop

# Atomic migration temporary database namespace and its sidecars
*.migrate-*.tmp
*.migrate-*.tmp-journal
*.migrate-*.tmp-wal
*.migrate-*.tmp-shm

# Operating system files
.DS_Store
Thumbs.db

# Isolated feature workspaces
/.worktrees/
